# ===== Firmware Management Server =====
# Copy this file to .env and update the values

# Server
NODE_ENV=production
PORT=80
SERVER_BASE_URL=http://YOUR_SERVER_IP

# MongoDB (use Docker service name in Docker deployment)
MONGO_URI=mongodb://mongodb:27017/firmware_manager

# MQTT (external broker - no local broker needed)
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883

# JWT Authentication (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=CHANGE_ME_TO_A_STRONG_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_STRONG_SECRET
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Storage (Docker paths)
STORAGE_PATH=/app/storage
LOG_PATH=/app/logs

# SSL Certificates (optional, for HTTPS mode)
# HTTPS_PORT=443
# CERT_PATH=/app/certs

# File Upload (50MB)
MAX_FILE_SIZE=52428800

# Default Admin Account (CHANGE PASSWORD IN PRODUCTION!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# CORS
CORS_ORIGIN=*

# ===== Firmware Management Server =====

# Server
NODE_ENV=development
PORT=80
SERVER_BASE_URL=http://20.243.20.11

# MongoDB
MONGO_URI=mongodb://localhost:27017/firmware_manager

# MQTT
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883

# JWT
JWT_SECRET=dev-jwt-secret-firmware-mgmt
JWT_REFRESH_SECRET=dev-refresh-secret-firmware-mgmt
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Storage
STORAGE_PATH=./storage
LOG_PATH=./logs
CERT_PATH=../certs

# File Upload
MAX_FILE_SIZE=52428800

# Default Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGIN=*
